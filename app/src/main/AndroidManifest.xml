<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 자동차(Android Automotive) 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Pleos 권한: 쓰는 것만 선언한다 (미승인 권한 선언은 앱 심사 탈락 사유) -->
    <!-- 기어(P단) 읽기 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 내비 목적지·경로 정보 조회 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- 내비 목적지 요청 (보조 기능) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 위치, 근접 알림 -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- 음성 안내 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 화면이 내려가 있을 때도 입구 접근을 알아채기 위한 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 화면 유지 (Driver Distraction 최적화 선언) -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- 화면이 내려가 있어도 위치를 계속 받기 위한 서비스 (목적지가 정해진 동안만 실행) -->
        <service
            android:name=".GuidanceKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="목적지 근처에서 주차장 입구 안내를 띄우기 위한 차량 위치 감시" />
        </service>
    </application>

</manifest>
